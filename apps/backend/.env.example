# Environment Configuration Template for Production Backend
NODE_ENV=production
PORT=4000

# Database Configuration
# Direct connection string for Neon / PostgreSQL
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Authentication Config (Better-Auth)
# Secret should be a random string, URL should be your frontend domain
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://your-frontend-domain.com
BETTER_AUTH_TRUSTED_ORIGINS=https://your-frontend-domain.com

# Cryptography / Security
# NIK_ENCRYPTION_KEY_BASE64 must be 32 bytes base64 encoded
# NIK_HASH_PEPPER should be a long secure random string
NIK_ENCRYPTION_KEY_BASE64=
NIK_HASH_PEPPER=

# Admin configuration
ADMIN_EMAILS=admin@yourdomain.com

# Backend URL / CORS (for reverse proxying)
BACKEND_URL=https://api.yourdomain.com
CORS_ORIGIN=https://your-frontend-domain.com

# Shared secret used by Next.js (`/api/identity/register`) to POST /internal/bump
# on this backend after DB writes that must trigger the WebSocket sync bus.
# Generate: openssl rand -hex 32
INTERNAL_BUS_SECRET=

# Cloudflare R2 / S3 Storage config
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=
