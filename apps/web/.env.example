# Vercel Environment Variables for @abdimas/web (Frontend)
# Set these in Vercel Project Settings (Settings -> Environment Variables)
NODE_ENV=production

# Public Frontend URLs (use either rw25pharmindo.my.id or www.rw25pharmindo.my.id depending on your primary domain configuration in Vercel)
APP_URL=https://rw25pharmindo.my.id
NEXT_PUBLIC_APP_URL=https://rw25pharmindo.my.id
BETTER_AUTH_URL=https://rw25pharmindo.my.id
BETTER_AUTH_TRUSTED_ORIGINS=https://rw25pharmindo.my.id

# Backend API VPS URL (where the Docker Hono server is running)
# Next.js rewrites /api/platform/* to this URL
BACKEND_URL=https://api.rw25pharmindo.my.id

# Keep empty for default flow (allows Vercel server-side proxying to prevent CORS issues)
NEXT_PUBLIC_BACKEND_URL=

# Shared Database & Secrets (MUST match the backend VPS .env values exactly)
DATABASE_URL=
BETTER_AUTH_SECRET=
NIK_ENCRYPTION_KEY_BASE64=
NIK_HASH_PEPPER=
ADMIN_EMAILS=admin@rw25.local

# External Public Services URLs
NEXT_PUBLIC_KPU_DPT_URL=https://cekdptonline.kpu.go.id/
NEXT_PUBLIC_CEK_BANSOS_URL=https://cekbansos.kemensos.go.id/

# Google OAuth (Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SMTP relay for email OTP verification (e.g. Brevo free tier: smtp-relay.brevo.com)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@rw25pharmindo.my.id
